<section class="scrpg-wizard-shell">
  <nav class="scrpg-wizard-steps" aria-label="Creation steps">
    {{#each steps}}
      <span class="scrpg-wizard-step-chip{{#if active}} is-active{{/if}}{{#if done}} is-done{{/if}}" data-step-id="{{id}}">
        <span class="scrpg-wizard-step-index">{{index}}</span>
        <span class="scrpg-wizard-step-label">{{label}}</span>
      </span>
    {{/each}}
  </nav>

  <div class="scrpg-wizard-step">
    {{#if isMethodStep}}
      {{> "modules/scrpg-actor-compendium/templates/wizard/steps/method.hbs"}}
    {{else if isBackgroundStep}}
      {{> "modules/scrpg-actor-compendium/templates/wizard/steps/background.hbs"}}
    {{else if isBackgroundDetailsStep}}
      {{> "modules/scrpg-actor-compendium/templates/wizard/steps/backgroundDetails.hbs"}}
    {{else if isPowerSourceStep}}
      {{> "modules/scrpg-actor-compendium/templates/wizard/steps/powerSource.hbs"}}
    {{else if isPowerSourceDetailsStep}}
      {{> "modules/scrpg-actor-compendium/templates/wizard/steps/powerSourceDetails.hbs"}}
    {{else if isPlaceholderStep}}
      {{> "modules/scrpg-actor-compendium/templates/wizard/steps/placeholder.hbs"}}
    {{/if}}
  </div>

  <footer class="scrpg-wizard-footer">
    <button type="button" class="scrpg-wizard-btn" data-action="cancel">Cancel</button>
    <div class="scrpg-wizard-footer-nav">
      <button type="button" class="scrpg-wizard-btn" data-action="back" {{#unless canGoBack}}disabled{{/unless}}>Back</button>
      <button type="button" class="scrpg-wizard-btn scrpg-wizard-btn-primary" data-action="next" {{#unless canGoNext}}disabled{{/unless}}>Next</button>
    </div>
  </footer>
</section>
