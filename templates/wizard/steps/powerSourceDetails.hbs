<div class="scrpg-wizard-ps-details">
  <header class="scrpg-wizard-step-header">
    <h2>Power Source — Powers &amp; Abilities</h2>
    <p>
      <strong>{{selectedPowerSourceName}}</strong>:
      assign Background dice {{powerSourceDiceLabel}} to powers, then pick Yellow/Green abilities
      (selective — not dump-all).
    </p>
  </header>

  {{#if powersIntro}}
    <p class="scrpg-wizard-intro">{{powersIntro}}</p>
  {{/if}}

  <section class="scrpg-wizard-assign-block" aria-label="Power dice">
    <h3>Powers</h3>
    <div class="scrpg-wizard-assign-list">
      {{#each powerSlots}}
        <div class="scrpg-wizard-assign-row" data-slot-index="{{slotIndex}}">
          <label class="scrpg-wizard-assign-trait">
            <span class="label">{{#if required}}Required{{else}}Power{{/if}}</span>
            {{#if lockedUuid}}
              <input type="hidden" name="powerUuid.{{slotIndex}}" value="{{lockedUuid}}">
              <button
                type="button"
                class="content-link scrpg-wizard-chart-tag scrpg-wizard-locked-trait-tag"
                data-action="previewChartItem"
                data-uuid="{{lockedUuid}}"
                data-tooltip="Item"
                title="Open {{lockedName}}"
                aria-label="Open {{lockedName}}"
              >
                <i class="fa-solid fa-suitcase" inert aria-hidden="true"></i>{{lockedName}}
              </button>
            {{else}}
              <select name="powerUuid.{{slotIndex}}">
                <option value="">— choose —</option>
                {{#each traitOptions}}
                  <option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>
                {{/each}}
              </select>
            {{/if}}
          </label>
          <label class="scrpg-wizard-assign-die">
            <span class="label">Die</span>
            <select name="powerDie.{{slotIndex}}">
              <option value="">—</option>
              {{#each dieOptions}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>
        </div>
      {{/each}}
    </div>
  </section>

  {{#each abilityPickGroups}}
    <section
      class="scrpg-wizard-ability-block{{#if incomplete}} is-incomplete{{/if}}"
      aria-label="{{color}} abilities"
      id="scrpg-wizard-ability-pick-{{index}}"
    >
      <h3>
        {{title}}
        <span class="scrpg-wizard-pick-badge{{#if incomplete}} is-incomplete{{/if}}">
          {{selectedCount}} / {{count}}
        </span>
      </h3>
      {{#if grantText}}
        <p class="scrpg-wizard-intro">{{grantText}}</p>
      {{/if}}
      {{#if constraintNote}}
        <p class="scrpg-wizard-hint">{{constraintNote}}</p>
      {{/if}}
      <div class="scrpg-wizard-ability-list">
        {{#each abilities}}
          <div class="scrpg-wizard-ability-row{{#if selected}} is-open{{/if}}">
            <label class="scrpg-wizard-ability-option{{#if selected}} is-selected{{/if}}">
              <input
                type="checkbox"
                name="abilityPick.{{../index}}"
                value="{{uuid}}"
                {{#if selected}}checked{{/if}}
                {{#if disabled}}disabled{{/if}}
              >
              <button
                type="button"
                class="content-link scrpg-wizard-chart-tag"
                data-action="previewChartItem"
                data-uuid="{{uuid}}"
                data-tooltip="Item"
                title="Open {{name}}"
                aria-label="Open {{name}}"
              >
                <i class="fa-solid fa-suitcase" inert aria-hidden="true"></i>{{name}}
              </button>
              <span class="scrpg-wizard-ability-color">{{../color}}</span>
            </label>
            {{#if selected}}
              {{#if preview}}
                <p class="scrpg-wizard-intro">{{preview}}</p>
              {{/if}}
              {{#each slotRows}}
                <label class="scrpg-wizard-text-field scrpg-wizard-ability-slot">
                  <span class="label">Fill {{token}}</span>
                  <select name="psAbilitySlot.{{abilityKey}}.{{tokenKey}}">
                    <option value="">— choose —</option>
                    {{#each options}}
                      <option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}} ({{itemType}} {{die}})</option>
                    {{/each}}
                  </select>
                </label>
              {{/each}}
            {{/if}}
          </div>
        {{/each}}
      </div>
      <p class="scrpg-wizard-pick-count">
        Selected {{selectedCount}} / {{count}}
        {{#if incomplete}} — required to continue{{/if}}
      </p>
    </section>
  {{/each}}
</div>
