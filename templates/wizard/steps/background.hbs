<div class="scrpg-wizard-background">
  <header class="scrpg-wizard-step-header">
    <h2>Step 1 — Background</h2>
    <p>
      {{#if isGuided}}
        Roll 2d10 silently, then pick a legal row (one die or the sum of both).
      {{else}}
        Constructed: pick any background. Power-source die sizes still come from that row.
      {{/if}}
    </p>
  </header>

  {{#if isGuided}}
    <section class="scrpg-wizard-roll-panel" aria-label="Background roll">
      <div class="scrpg-wizard-roll-panel-copy">
        <span class="scrpg-wizard-roll-demo-title">Silent roll</span>
        {{#if rollSummary}}
          <span class="scrpg-wizard-roll-demo-result">
            <strong>{{rollSummary.formula}}</strong>
            {{#if rollSummary.detail}}
              <span class="scrpg-wizard-roll-demo-detail">{{rollSummary.detail}}</span>
            {{/if}}
          </span>
          {{#if legalNumbers.length}}
            <span class="scrpg-wizard-legal-nums">Legal rows: {{#each legalNumbers}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</span>
          {{/if}}
        {{else}}
          <span class="scrpg-wizard-roll-demo-hint">Roll 2d10 to unlock legal backgrounds.</span>
        {{/if}}
      </div>
      <div class="scrpg-wizard-roll-demo-actions">
        {{#unless rollSummary}}
          <button type="button" class="scrpg-wizard-btn" data-action="chartRoll">
            <i class="fas fa-dice"></i> Roll 2d10
          </button>
        {{/unless}}
        <button type="button" class="scrpg-wizard-btn" data-action="chartReroll" {{#unless rollSummary}}disabled{{/unless}}>
          <i class="fas fa-rotate"></i> Re-roll
        </button>
      </div>
    </section>
  {{/if}}

  <div class="scrpg-wizard-chart-list" role="radiogroup" aria-label="Backgrounds">
    {{#each chartRows}}
      <div class="scrpg-wizard-chart-row{{#if selected}} is-selected{{/if}}{{#unless available}} is-locked{{/unless}}">
        <label class="scrpg-wizard-chart-select">
          <input
            type="radio"
            name="backgroundNumber"
            value="{{number}}"
            data-uuid="{{uuid}}"
            {{#if selected}}checked{{/if}}
            {{#unless available}}disabled{{/unless}}
          >
          <span class="scrpg-wizard-chart-num">{{number}}</span>
          <span class="scrpg-wizard-chart-body">
            <button
              type="button"
              class="content-link scrpg-wizard-chart-tag"
              data-action="previewChartItem"
              data-uuid="{{uuid}}"
              data-tooltip="Item"
              title="Open {{name}}"
              aria-label="Open {{name}}"
            >
              <i class="fa-solid fa-suitcase" inert aria-hidden="true"></i>{{name}}
            </button>
            <span class="scrpg-wizard-chart-meta">PS dice: {{powerSourceDiceLabel}} · Principle: {{principleLabel}}</span>
          </span>
        </label>
      </div>
    {{/each}}
  </div>
</div>
